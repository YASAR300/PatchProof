# PatchProof Environment Variables
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# Database Configuration (PostgreSQL 16)
# Local Docker development connection:
DATABASE_URL="postgresql://patchproof:patchproof_secret@localhost:5432/patchproof?schema=public"
DIRECT_URL="postgresql://patchproof:patchproof_secret@localhost:5432/patchproof?schema=public"

# For hosted serverless databases (e.g. Neon or Supabase):
# DATABASE_URL uses pooled connection (port 6543 / pgbouncer) for application runtime queries.
# DIRECT_URL uses direct connection (port 5432) for Prisma schema migrations and DDL operations.
# DATABASE_URL="postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Initial Demo Seed User Credentials
SEED_USER_EMAIL="admin@patchproof.dev"
SEED_USER_PASSWORD="change_me_to_your_secure_password"

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET="generate_with_openssl_rand_base64_32"
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"

# Optional GitHub OAuth (enabled only when both are set)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
